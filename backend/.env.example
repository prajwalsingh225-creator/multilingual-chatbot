# --- application ---
APP_NAME="Multilingual Context-Aware Chatbot"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated or JSON list; must include the frontend origin.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- database ---
# Relative sqlite paths are resolved against backend/.
DATABASE_URL=sqlite:///./chatbot.db

# --- model / NLP ---
MODEL_NAME=xlm-roberta-base
MODEL_DIR=trained_models/intent_model
SUPPORTED_LANGUAGES=en,hi,es
DEFAULT_LANGUAGE=en
INTENT_CONFIDENCE_THRESHOLD=0.55

# --- conversation ---
MAX_CONTEXT_MESSAGES=10
SESSION_TIMEOUT_MINUTES=30

# --- business info used in reply placeholders ---
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+91-1800-000-000

# --- data paths ---
DATA_DIR=data